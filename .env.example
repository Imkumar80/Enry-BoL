# Enry-BoL Environment Variables

# --- Server ---
PORT=8000
HOST=127.0.0.1

# --- Ollama (Local LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- ASR (Speech-to-Text) ---
ASR_PROVIDER=deepgram
DEEPGRAM_API_KEY=

# --- VAD (Voice Activity Detection) ---
VAD_MODE=2
VAD_FRAME_MS=20
VAD_END_SILENCE_MS=500

# --- TTS (Cartesia Sonic) ---
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=3b554273-4299-48b9-9aaf-eefd438e3941

# --- Legacy (NLU Parser fallback) ---
GEMINI_API_KEY=
