# Enry-BoL Environment Variables

PORT=8000
HOST=127.0.0.1

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Streaming ASR ---
ASR_PROVIDER=deepgram
DEEPGRAM_API_KEY=
